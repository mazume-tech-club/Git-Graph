{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Graph",
  "mainBinaryName": "git-graph",
  "version": "1.2.1",
  "identifier": "jp.asuzacgroup.gitgraph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Graph",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRkU5OEQ4MUZCOEU2NjMKUldSajVyZ2YySmorUUVWK3MyVWZJVW5uR216VGxFNXZPVEtLTGNuYU5ZK3QzT2FYeGZCaDB1eTIK",
      "endpoints": [
        "http://gitea.asuzacfoods.jp/asuzacfoods/Git-Graph/raw/branch/main/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
